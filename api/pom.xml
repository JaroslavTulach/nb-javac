<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dukescript.nbjavac</groupId>
        <artifactId>nb-javac-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>nb-javac-api</artifactId>
    <name>nb-javac API</name>

    <properties>
        <nbjavac.root>${project.basedir}/..</nbjavac.root>
        <nbjavac.output.dir>${project.build.directory}</nbjavac.output.dir>
        <nbjavac.ant.dir>${nbjavac.root}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
        <src.dir>${project.build.directory}/generated/java</src.dir>
        <jackpot.profile>jdk8+</jackpot.profile>
        <jackpot.hint.files>nbjavac-jdk21.hint,nbjavac.hint</jackpot.hint.files>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dukescript.nbjavac</groupId>
            <artifactId>nb-javac</artifactId>
            <version>jdk-21u</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${src.dir}/java.compiler/share/classes</sourceDirectory>
        <resources>
            <resource>
                <directory>${nbjavac.root}</directory>
                <includes>
                    <include>README.md</include>
                    <include>SECURITY.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${nbjavac.root}/src/generated</directory>
                        </fileset>
                        <fileset>
                            <directory>${nbjavac.root}/src</directory>
                            <includes>
                                <include>java.base/**</include>
                                <include>java.compiler/**</include>
                                <include>jdk.compiler/**</include>
                                <include>jackpot-done</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${nbjavac.root}/lib</directory>
                            <includes>
                                <include>**/*.class</include>
                                <include>**/*.jar</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.dukescript.nbjavac</groupId>
                        <artifactId>nb-javac-shared</artifactId>
                        <version>${project.version}</version>
                        <classifier>sources</classifier>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>download-tools</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${nbjavac.root}/lib</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.netbeans.modules.jackpot30</groupId>
                                    <artifactId>tool</artifactId>
                                    <version>28.0</version>
                                    <destFileName>jackpot.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>unpack-shared-sources</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-shared</outputDirectory>
                            <includes>nbjavac/**/*.java</includes>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.dukescript.nbjavac</groupId>
                                    <artifactId>nb-javac-shared</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>sources</classifier>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant</artifactId>
                        <version>1.10.15</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant-launcher</artifactId>
                        <version>1.10.15</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <target>
                        <ant dir="${nbjavac.ant.dir}" inheritAll="true"/>
                    </target>
                </configuration>
                <executions>
                    <execution>
                        <id>checkout-jdk</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <ant target="init"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jackpot</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <ant target="generate-files"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${src.dir}/jdk.compiler/share/classes</source>
                                <source>${src.dir}/java.base/share/classes</source>
                                <source>${project.build.directory}/generated-shared</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-sourceversion-java11</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/sourceversion-java11/javax/lang/model</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${nbjavac.root}/jdk/src/java.compiler/share/classes/javax/lang/model</directory>
                                    <includes>
                                        <include>SourceVersion.java</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.frgaal</groupId>
                        <artifactId>compiler-maven-plugin</artifactId>
                        <version>25.0.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <compilerId>frgaal</compilerId>
                    <source>24</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                    <debug>true</debug>
                    <createMissingPackageInfoClass>false</createMissingPackageInfoClass>
                    <compilerArgs>
                        <arg>--limit-modules</arg>
                        <arg>java.base</arg>
                        <!-- Resolve implementation imports from the bootstrap JAR, not the generated sources. -->
                        <arg>-sourcepath</arg>
                        <arg>${project.build.directory}/no-sources</arg>
                    </compilerArgs>
                    <includes>
                        <include>javax/lang/**</include>
                        <include>javax/tools/*.java</include>
                        <include>javax/annotation/**</include>
                        <include>com/sun/source/**</include>
                        <include>jdk/internal/PreviewFeature.java</include>
                        <!-- These helpers are needed to compile the JDK 8 API, but belong in the implementation JAR. -->
                        <include>nbjavac/jdk8/RuntimeWR.java</include>
                        <include>nbjavac/jdk8/ServiceLoaderWrapper.java</include>
                        <include>nbjavac/jdk8/ModuleWrapper*.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-sourceversion-java11</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.build.directory}/sourceversion-java11</compileSourceRoot>
                            </compileSourceRoots>
                            <includes combine.self="override">
                                <include>javax/lang/model/SourceVersion.java</include>
                            </includes>
                            <target>11</target>
                            <useIncrementalCompilation>false</useIncrementalCompilation>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/versions/11</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                        <manifestEntries>
                            <Multi-Release>true</Multi-Release>
                        </manifestEntries>
                    </archive>
                    <excludes>
                        <exclude>nbjavac/**</exclude>
                        <exclude>META-INF/jpms.args</exclude>
                        <exclude>META-INF/versions/*/META-INF/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>clean-jdk</id>
            <activation>
                <property>
                    <name>clean.jdk</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <configuration>
                            <filesets combine.children="append">
                                <fileset>
                                    <directory>${nbjavac.root}/jdk</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
