<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dukescript.nbjavac</groupId>
  <artifactId>nb-javac</artifactId>
  <version>${revision}</version>
  <!-- The jars, including the sources one, are created by the standard lifecycle -->
  <packaging>jar</packaging>

  <name>nb-javac</name>
  <description>
      `nb-javac` is a "backport" of OpenJDK `javac`, i.e., the Java compiler.
      It allows to run the latest OpenJDK compiler on older JDKs - as old
      as JDK8 while being 1:1 identical with the official `javac`.
      Use `nb-javac` to execute the latest Java language compiler on old
      JDKs!
  </description>
  <url>https://github.com/jaroslavtulach/nb-javac</url>

  <licenses>
    <license>
      <name>GPLv2-CPE</name>
      <url>https://openjdk.java.net/legal/gplv2+ce.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/jaroslavtulach/nb-javac.git</connection>
    <developerConnection>scm:git:git@github.com:jaroslavtulach/nb-javac.git</developerConnection>
    <url>https://github.com/jaroslavtulach/nb-javac</url>
  </scm>

  <developers>
    <developer>
      <email>jaroslav.tulach@apidesign.org</email>
      <name>Jaroslav Tulach</name>
      <url>https://github.com/jaroslavtulach</url>
      <roles>
        <role>Developer</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <!-- OpenJDK sources to build from, the version of the artifacts follows the commit/tag -->
    <jdk.git.url>https://github.com/openjdk/jdk</jdk.git.url>
    <jdk.git.commit>jdk-28+23</jdk.git.commit>
    <revision>${jdk.git.commit}</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- deploying is enabled by the release profile -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <nbjavac.tools.dir>${project.basedir}/lib</nbjavac.tools.dir>
    <nbjavac.ant.dir>${project.basedir}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
  </properties>

  <dependencies>
    <dependency>
      <!-- provides com.sun.tools.javap, com.sun.tools.classfile and nbjavac.sun.annotation which are not compiled from the JDK sources -->
      <groupId>com.dukescript.nbjavac</groupId>
      <artifactId>nb-javac</artifactId>
      <version>jdk-21u</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/make/langtools/netbeans/nb-javac/src</sourceDirectory>
    <testSourceDirectory>${project.basedir}/make/langtools/netbeans/nb-javac/test</testSourceDirectory>
    <testResources>
      <!-- prebuilt class files used as test data -->
      <testResource>
        <directory>${project.basedir}/make/langtools/netbeans/nb-javac/test</directory>
        <includes>
          <include>**/*.class</include>
        </includes>
      </testResource>
    </testResources>
    <resources>
      <resource>
        <!-- packaged into the jars -->
        <directory>${project.basedir}</directory>
        <includes>
          <include>README.md</include>
          <include>SECURITY.md</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/make/langtools/netbeans/nb-javac/src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/src/java.compiler/share/classes</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/src/jdk.compiler/share/classes</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>com/sun/tools/javac/launcher/**</exclude>
          <exclude>com/sun/tools/javac/sym/**</exclude>
          <exclude>com/sun/tools/sjavac/**</exclude>
          <exclude>sun/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- besides target, the sources processed by jackpot are removed; see the clean-jdk profile as well -->
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.basedir}/src</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
      <plugin>
        <!-- the jackpot tool used by the Ant build; it is copied to its tools.dir -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <outputDirectory>${nbjavac.tools.dir}</outputDirectory>
          <artifactItems>
            <artifactItem>
              <groupId>org.apache.netbeans.modules.jackpot30</groupId>
              <artifactId>tool</artifactId>
              <version>28.0</version>
              <destFileName>jackpot.jar</destFileName>
            </artifactItem>
          </artifactItems>
        </configuration>
        <executions>
          <execution>
            <id>download-tools</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy</goal>
            </goals>
          </execution>
          <execution>
            <!-- classes which are not compiled from the JDK sources, see also the provided dependency -->
            <id>unpack-reflect</id>
            <phase>initialize</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <includes>nbjavac/sun/annotation/**,com/sun/tools/classfile/**,com/sun/tools/javap/**</includes>
              <artifactItems>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId>
                  <artifactId>nb-javac</artifactId>
                  <version>jdk-21u</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <!-- platform data used by nb-javac running on JDK 8, packaged into the impl jar -->
            <id>unpack-ct-sym</id>
            <phase>initialize</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <includes>META-INF/ct*/**</includes>
              <artifactItems>
                <artifactItem>
                  <groupId>org.frgaal</groupId>
                  <artifactId>compiler</artifactId>
                  <version>25.0.0</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Declares the remaining main source roots, the generated ones are produced by the generate-sources phase -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/java.compiler/share/classes</source>
                <source>${project.basedir}/src/jdk.compiler/share/classes</source>
                <source>${project.basedir}/src/java.base/share/classes</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- publishes the pom with ${revision} resolved -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.7.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
          <pomElements>
            <!-- the dependencies are only used to build nb-javac -->
            <dependencies>remove</dependencies>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <!-- only this file of the original sources, so that the other classes are taken from the classpath -->
            <id>copy-sourceversion-java11</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/sourceversion-java11/javax/lang/model</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/jdk/src/java.compiler/share/classes/javax/lang/model</directory>
                  <includes>
                    <include>SourceVersion.java</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- frgaal: compiles the modern JDK sources into Java 8 bytecode -->
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <dependencies>
          <dependency>
            <groupId>org.frgaal</groupId>
            <artifactId>compiler-maven-plugin</artifactId>
            <version>25.0.0</version>
          </dependency>
        </dependencies>
        <configuration>
          <compilerId>frgaal</compilerId>
          <source>24</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
          <debug>true</debug>
          <createMissingPackageInfoClass>false</createMissingPackageInfoClass>
          <compilerArgs>
            <arg>--limit-modules</arg>
            <arg>java.base</arg>
          </compilerArgs>
          <excludes>
            <exclude>**/module-info.java</exclude>
            <exclude>com/sun/tools/javac/launcher/**</exclude>
            <exclude>com/sun/tools/javac/main/JavacToolProvider.java</exclude>
            <exclude>com/sun/tools/sjavac/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <!-- the original SourceVersion uses Runtime.Version, the Java 8 variant (default-compile) cannot -->
            <id>compile-sourceversion-java11</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.build.directory}/sourceversion-java11</compileSourceRoot>
              </compileSourceRoots>
              <includes>
                <include>javax/lang/model/SourceVersion.java</include>
              </includes>
              <target>11</target>
              <useIncrementalCompilation>false</useIncrementalCompilation>
              <outputDirectory>${project.build.outputDirectory}/META-INF/versions/11</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <!-- like the former Ant junit task: a new JVM per test class -->
          <reuseForks>false</reuseForks>
          <!-- the same classes as the former Ant junit run -->
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <addMavenDescriptor>false</addMavenDescriptor>
          </archive>
        </configuration>
        <executions>
          <execution>
            <!-- the implementation jar is the main artifact -->
            <id>default-jar</id>
            <configuration>
              <includes>
                <include>META-INF/services/**</include>
                <include>META-INF/ct*/**</include>
                <include>com/sun/tools/**</include>
                <include>jdk/internal/shellsupport/**</include>
                <include>jdk/internal/PreviewFeature*</include>
                <include>nbjavac/**</include>
                <include>README.md</include>
                <include>SECURITY.md</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <!-- the sources of nb-javac are the processed ones -->
            <id>sources-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>sources</classifier>
              <classesDirectory>${project.basedir}</classesDirectory>
              <includes>
                <include>src/java.base/**</include>
                <include>src/jdk.compiler/**</include>
                <include>src/java.compiler/**</include>
                <include>make/langtools/netbeans/nb-javac/**</include>
                <include>make/langtools/tools/**</include>
                <include>make/langtools/build.xml</include>
                <include>make/langtools/build.properties</include>
                <include>README.md</include>
                <include>SECURITY.md</include>
                <include>LICENSE.txt</include>
                <include>CONTRIBUTING.md</include>
              </includes>
              <excludes>
                <exclude>**/build/**</exclude>
                <exclude>**/dist/**</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>api-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>api</classifier>
              <archive>
                <manifestEntries>
                  <Multi-Release>true</Multi-Release>
                </manifestEntries>
              </archive>
              <includes>
                <include>com/sun/source/**</include>
                <include>javax/lang/**</include>
                <include>javax/tools/*</include>
                <include>jdk/internal/PreviewFeature*</include>
                <include>javax/annotation/**</include>
                <include>META-INF/versions/**</include>
                <include>README.md</include>
                <include>SECURITY.md</include>
              </includes>
              <excludes>
                <!-- written by the compiler plugin -->
                <exclude>META-INF/versions/*/META-INF/**</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <dependencies>
          <!-- Ant 1.10.12 bundled with the plugin fails on JDK 24+ (Security Manager removed) -->
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.10.15</version>
          </dependency>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-launcher</artifactId>
            <version>1.10.15</version>
          </dependency>
        </dependencies>
        <!--
          All Maven properties, including -D ones (e.g. jdk.git.url, jdk.git.commit), are inherited by Ant.
          The executions below only specify the Ant target to run.
        -->
        <configuration>
          <target>
            <ant dir="${nbjavac.ant.dir}" inheritAll="true"/>
          </target>
        </configuration>
        <executions>
          <execution>
            <id>checkout-jdk</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="init"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jackpot</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="generate-files"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!--
        mvn clean -Dclean.jdk=true
        also removes the checkout of the OpenJDK repository including any local changes in it.
        The next build clones it again, which takes a while.
      -->
      <id>clean-jdk</id>
      <activation>
        <property>
          <name>clean.jdk</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets combine.children="append">
                <fileset>
                  <directory>${project.basedir}/jdk</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- on JDK 8 the nb-javac classes have to precede the JDK's own javax.tools etc. -->
      <id>jdk8-tests</id>
      <activation>
        <jdk>1.8</jdk>
      </activation>
      <properties>
        <argLine>-Xbootclasspath/p:${project.build.outputDirectory}</argLine>
      </properties>
    </profile>
    <profile>
      <!-- hide the JDK's own jdk.compiler (and java.compiler), the tested nb-javac is on the classpath instead -->
      <id>jdk9-tests</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <!-- java.management is needed by the surefire booter itself -->
        <argLine>-Ddebug=false --limit-modules java.base,java.xml,jdk.zipfs,java.management</argLine>
      </properties>
    </profile>
    <profile>
      <!--
        Signs the artifacts and uploads them directly to the Maven Central by
          mvn clean deploy -DskipTests -Prelease
        The credentials (a Central Portal user token) are expected in settings.xml
        as the server with id "central". Use -Dcentral.skipUpload=true to only create
        the bundle target/central-publishing/central-bundle.zip without uploading it.
      -->
      <id>release</id>
      <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
        <central.skipUpload>false</central.skipUpload>
      </properties>
      <build>
        <plugins>
          <plugin>
            <!-- Central requires a javadoc jar, there is no Java API documentation of nb-javac to put in -->
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>javadoc-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.basedir}</classesDirectory>
                  <includes>
                    <include>README.md</include>
                    <include>SECURITY.md</include>
                    <include>LICENSE.txt</include>
                    <include>CONTRIBUTING.md</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- the deploy phase uploads a bundle to the Central Portal; it has to be published manually there -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <skipUpload>${central.skipUpload}</skipUpload>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
