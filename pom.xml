<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.netbeans.external</groupId>
  <artifactId>nb-javac-build</artifactId>
  <version>1.0-SNAPSHOT</version>
  <!-- Only wraps the Ant build; real artifacts are produced in make/langtools/netbeans/nb-javac/dist -->
  <packaging>pom</packaging>

  <name>nb-javac build wrapper</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <skipTests>false</skipTests>
    <!-- artifacts are published by the Ant targets from the profiles below -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <nbjavac.ant.dir>${project.basedir}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Declares source roots for IDEs; compilation itself is done by the Ant build -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/java.compiler/share/classes</source>
                <source>${project.basedir}/src/jdk.compiler/share/classes</source>
                <source>${project.basedir}/src/jdk.jdeps/share/classes</source>
                <source>${project.basedir}/make/langtools/netbeans/nb-javac/src</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/make/langtools/netbeans/nb-javac/test</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <dependencies>
          <!-- Ant 1.10.12 bundled with the plugin fails on JDK 24+ (Security Manager removed) -->
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.10.15</version>
          </dependency>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-launcher</artifactId>
            <version>1.10.15</version>
          </dependency>
          <!-- optional Ant tasks needed by the "test" target -->
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-junit</artifactId>
            <version>1.10.15</version>
          </dependency>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-junit4</artifactId>
            <version>1.10.15</version>
          </dependency>
        </dependencies>
        <!-- -D properties given on the Maven command line (e.g. jdk.git.url, jdk.git.commit) are passed to Ant -->
        <executions>
          <execution>
            <id>clean</id>
            <phase>clean</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="clean" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>checkout-jdk</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="init" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jackpot</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="generate-files" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="compile" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>test</id>
            <phase>test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
                <skip>${skipTests}</skip>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="test" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="jar" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>sources-zip</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="zip-nb-javac-sources" inheritAll="false">
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- both need -Dmaven.groupId=your.grp.id -->
    <profile>
      <id>ossrh-snapshots</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>ossrh-snapshots</id>
                <phase>deploy</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <ant dir="${nbjavac.ant.dir}" target="publish-to-ossrh-snapshots" inheritAll="false">
                      <propertyset>
                        <propertyref builtin="commandline"/>
                      </propertyset>
                    </ant>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>maven-central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>maven-central</id>
                <phase>deploy</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <ant dir="${nbjavac.ant.dir}" target="publish-to-maven-central" inheritAll="false">
                      <propertyset>
                        <propertyref builtin="commandline"/>
                      </propertyset>
                    </ant>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
