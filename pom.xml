<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dukescript.nbjavac</groupId>
  <artifactId>nb-javac</artifactId>
  <version>${revision}</version>
  <!-- The jars are built by the Ant build and attached to the project in the package phase -->
  <packaging>pom</packaging>

  <name>nb-javac</name>
  <description>
      `nb-javac` is a "backport" of OpenJDK `javac`, i.e., the Java compiler.
      It allows to run the latest OpenJDK compiler on older JDKs - as old
      as JDK8 while being 1:1 identical with the official `javac`.
      Use `nb-javac` to execute the latest Java language compiler on old
      JDKs!
  </description>
  <url>https://github.com/jaroslavtulach/nb-javac</url>

  <licenses>
    <license>
      <name>GPLv2-CPE</name>
      <url>https://openjdk.java.net/legal/gplv2+ce.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/jaroslavtulach/nb-javac.git</connection>
    <developerConnection>scm:git:git@github.com:jaroslavtulach/nb-javac.git</developerConnection>
    <url>https://github.com/jaroslavtulach/nb-javac</url>
  </scm>

  <developers>
    <developer>
      <email>jaroslav.tulach@apidesign.org</email>
      <name>Jaroslav Tulach</name>
      <url>https://github.com/jaroslavtulach</url>
      <roles>
        <role>Developer</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <!-- OpenJDK sources to build from, the version of the artifacts follows the commit/tag -->
    <jdk.git.url>https://github.com/openjdk/jdk</jdk.git.url>
    <jdk.git.commit>jdk-28+23</jdk.git.commit>
    <revision>${jdk.git.commit}</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- artifacts are published by the Ant targets from the profiles below -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <nbjavac.tools.dir>${project.basedir}/lib</nbjavac.tools.dir>
    <nbjavac.ant.dir>${project.basedir}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
    <!-- inherited by Ant: the classes are compiled by Maven, Ant only assembles the jars from them -->
    <maven.compiled>true</maven.compiled>
    <build.classes.dir>${project.build.outputDirectory}</build.classes.dir>
  </properties>

  <dependencies>
    <dependency>
      <!-- provides com.sun.tools.javap, com.sun.tools.classfile and nbjavac.sun.annotation which are not compiled from the JDK sources -->
      <groupId>com.dukescript.nbjavac</groupId>
      <artifactId>nb-javac</artifactId>
      <version>jdk-21u</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/make/langtools/netbeans/nb-javac/src</sourceDirectory>
    <testSourceDirectory>${project.basedir}/make/langtools/netbeans/nb-javac/test</testSourceDirectory>
    <testResources>
      <!-- prebuilt class files used as test data -->
      <testResource>
        <directory>${project.basedir}/make/langtools/netbeans/nb-javac/test</directory>
        <includes>
          <include>**/*.class</include>
        </includes>
      </testResource>
    </testResources>
    <resources>
      <resource>
        <directory>${project.basedir}/make/langtools/netbeans/nb-javac/src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/src/java.compiler/share/classes</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}/src/jdk.compiler/share/classes</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>com/sun/tools/javac/launcher/**</exclude>
          <exclude>com/sun/tools/javac/sym/**</exclude>
          <exclude>com/sun/tools/sjavac/**</exclude>
          <exclude>sun/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- tools used by the Ant build; they are copied to its tools.dir -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <outputDirectory>${nbjavac.tools.dir}</outputDirectory>
          <artifactItems>
            <artifactItem>
              <groupId>org.apache.netbeans.modules.jackpot30</groupId>
              <artifactId>tool</artifactId>
              <version>28.0</version>
              <destFileName>jackpot.jar</destFileName>
            </artifactItem>
            <artifactItem>
              <groupId>org.frgaal</groupId>
              <artifactId>compiler</artifactId>
              <version>25.0.0</version>
              <destFileName>compiler.jar</destFileName>
            </artifactItem>
            <artifactItem>
              <groupId>com.dukescript.nbjavac</groupId>
              <artifactId>nb-javac</artifactId>
              <version>jdk-21u</version>
              <destFileName>nb-javac-jdk-21u.jar</destFileName>
            </artifactItem>
            <artifactItem>
              <groupId>junit</groupId>
              <artifactId>junit</artifactId>
              <version>4.12</version>
              <destFileName>junit-4.12.jar</destFileName>
            </artifactItem>
            <artifactItem>
              <groupId>org.hamcrest</groupId>
              <artifactId>hamcrest-core</artifactId>
              <version>1.3</version>
              <destFileName>hamcrest-core-1.3.jar</destFileName>
            </artifactItem>
          </artifactItems>
        </configuration>
        <executions>
          <!-- the Ant "clean" target needs the tools as well -->
          <execution>
            <id>download-tools-for-clean</id>
            <phase>pre-clean</phase>
            <goals>
              <goal>copy</goal>
            </goals>
          </execution>
          <execution>
            <id>download-tools</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy</goal>
            </goals>
          </execution>
          <execution>
            <!-- classes which are not compiled from the JDK sources, see also the provided dependency -->
            <id>unpack-reflect</id>
            <phase>initialize</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <outputDirectory>${nbjavac.tools.dir}/reflect</outputDirectory>
              <includes>nbjavac/sun/annotation/**,com/sun/tools/classfile/**,com/sun/tools/javap/**</includes>
              <artifactItems>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId>
                  <artifactId>nb-javac</artifactId>
                  <version>jdk-21u</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <!-- platform data used by nb-javac running on JDK 8; the Ant build puts it into the impl jar -->
            <id>unpack-ct-sym</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/ct-sym</outputDirectory>
              <includes>META-INF/ct*/**</includes>
              <artifactItems>
                <artifactItem>
                  <groupId>org.frgaal</groupId>
                  <artifactId>compiler</artifactId>
                  <version>25.0.0</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Declares the remaining main source roots, the generated ones are produced by the generate-sources phase -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/java.compiler/share/classes</source>
                <source>${project.basedir}/src/jdk.compiler/share/classes</source>
                <source>${project.basedir}/src/java.base/share/classes</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>attach-artifacts</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${nbjavac.ant.dir}/dist/nb-javac-${jdk.git.commit}-impl.jar</file>
                  <type>jar</type>
                </artifact>
                <artifact>
                  <file>${nbjavac.ant.dir}/dist/nb-javac-${jdk.git.commit}-api.jar</file>
                  <type>jar</type>
                  <classifier>api</classifier>
                </artifact>
                <artifact>
                  <file>${nbjavac.ant.dir}/dist/nb-javac-${jdk.git.commit}-sources.zip</file>
                  <type>jar</type>
                  <classifier>sources</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- publishes the pom with ${revision} resolved -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.7.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>resources</id>
            <phase>process-resources</phase>
            <goals>
              <goal>resources</goal>
            </goals>
          </execution>
          <execution>
            <id>test-resources</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>testResources</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- frgaal: compiles the modern JDK sources into Java 8 bytecode -->
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <dependencies>
          <dependency>
            <groupId>org.frgaal</groupId>
            <artifactId>compiler-maven-plugin</artifactId>
            <version>25.0.0</version>
          </dependency>
        </dependencies>
        <configuration>
          <compilerId>frgaal</compilerId>
          <source>24</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
          <debug>true</debug>
          <createMissingPackageInfoClass>false</createMissingPackageInfoClass>
          <compilerArgs>
            <arg>--limit-modules</arg>
            <arg>java.base</arg>
          </compilerArgs>
          <excludes>
            <exclude>**/module-info.java</exclude>
            <exclude>com/sun/tools/javac/launcher/**</exclude>
            <exclude>com/sun/tools/javac/main/JavacToolProvider.java</exclude>
            <exclude>com/sun/tools/sjavac/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>test-compile</phase>
            <goals>
              <goal>testCompile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <!-- like the former Ant junit task: a new JVM per test class -->
          <reuseForks>false</reuseForks>
          <!-- the same classes as the former Ant junit run -->
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>test</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <dependencies>
          <!-- Ant 1.10.12 bundled with the plugin fails on JDK 24+ (Security Manager removed) -->
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.10.15</version>
          </dependency>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-launcher</artifactId>
            <version>1.10.15</version>
          </dependency>
        </dependencies>
        <!--
          All Maven properties, including -D ones (e.g. jdk.git.url, jdk.git.commit), are inherited by Ant.
          The executions below only specify the Ant target to run.
        -->
        <configuration>
          <target>
            <ant dir="${nbjavac.ant.dir}" inheritAll="true"/>
          </target>
        </configuration>
        <executions>
          <execution>
            <id>clean</id>
            <phase>clean</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="clean"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>checkout-jdk</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="init"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jackpot</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="generate-files"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="jar"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>sources-zip</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant target="zip-nb-javac-sources"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- on JDK 8 the nb-javac classes have to precede the JDK's own javax.tools etc. -->
      <id>jdk8-tests</id>
      <activation>
        <jdk>1.8</jdk>
      </activation>
      <properties>
        <argLine>-Xbootclasspath/p:${project.build.outputDirectory}:${nbjavac.tools.dir}/reflect:${project.build.directory}/ct-sym</argLine>
      </properties>
    </profile>
    <profile>
      <!-- hide the JDK's own jdk.compiler (and java.compiler), the tested nb-javac is on the classpath instead -->
      <id>jdk9-tests</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <!-- java.management is needed by the surefire booter itself -->
        <argLine>-Ddebug=false --limit-modules java.base,java.xml,jdk.zipfs,java.management</argLine>
      </properties>
    </profile>
    <!-- both publishing profiles need -Dmaven.groupId=your.grp.id -->
    <profile>
      <id>ossrh-snapshots</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>ossrh-snapshots</id>
                <phase>deploy</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <ant target="publish-to-ossrh-snapshots"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>maven-central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>maven-central</id>
                <phase>deploy</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <ant target="publish-to-maven-central"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
