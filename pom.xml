<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dukescript.nbjavac</groupId>
  <artifactId>nb-javac</artifactId>
  <version>${revision}</version>
  <!-- The jars are built by the Ant build and attached to the project in the package phase -->
  <packaging>pom</packaging>

  <name>nb-javac</name>
  <description>
      `nb-javac` is a "backport" of OpenJDK `javac`, i.e., the Java compiler.
      It allows to run the latest OpenJDK compiler on older JDKs - as old
      as JDK8 while being 1:1 identical with the official `javac`.
      Use `nb-javac` to execute the latest Java language compiler on old
      JDKs!
  </description>
  <url>https://github.com/jaroslavtulach/nb-javac</url>

  <licenses>
    <license>
      <name>GPLv2-CPE</name>
      <url>https://openjdk.java.net/legal/gplv2+ce.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/jaroslavtulach/nb-javac.git</connection>
    <developerConnection>scm:git:git@github.com:jaroslavtulach/nb-javac.git</developerConnection>
    <url>https://github.com/jaroslavtulach/nb-javac</url>
  </scm>

  <developers>
    <developer>
      <email>jaroslav.tulach@apidesign.org</email>
      <name>Jaroslav Tulach</name>
      <url>https://github.com/jaroslavtulach</url>
      <roles>
        <role>Developer</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <!-- OpenJDK sources to build from, the version of the artifacts follows the commit/tag -->
    <jdk.git.url>https://github.com/openjdk/jdk</jdk.git.url>
    <jdk.git.commit>jdk-28+23</jdk.git.commit>
    <revision>${jdk.git.commit}</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <skipTests>false</skipTests>
    <!-- artifacts are published by the Ant targets from the profiles below -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <nbjavac.ant.dir>${project.basedir}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/make/langtools/netbeans/nb-javac/src</sourceDirectory>
    <testSourceDirectory>${project.basedir}/make/langtools/netbeans/nb-javac/test</testSourceDirectory>
    <plugins>
      <plugin>
        <!-- Declares the remaining main source roots for IDEs; compilation itself is done by the Ant build -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/java.compiler/share/classes</source>
                <source>${project.basedir}/src/jdk.compiler/share/classes</source>
                <source>${project.basedir}/src/jdk.jdeps/share/classes</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>attach-artifacts</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${nbjavac.ant.dir}/dist/nb-javac-${jdk.git.commit}-impl.jar</file>
                  <type>jar</type>
                </artifact>
                <artifact>
                  <file>${nbjavac.ant.dir}/dist/nb-javac-${jdk.git.commit}-api.jar</file>
                  <type>jar</type>
                  <classifier>api</classifier>
                </artifact>
                <artifact>
                  <file>${nbjavac.ant.dir}/dist/nb-javac-${jdk.git.commit}-sources.zip</file>
                  <type>jar</type>
                  <classifier>sources</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- publishes the pom with ${revision} resolved -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.7.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <dependencies>
          <!-- Ant 1.10.12 bundled with the plugin fails on JDK 24+ (Security Manager removed) -->
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.10.15</version>
          </dependency>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-launcher</artifactId>
            <version>1.10.15</version>
          </dependency>
          <!-- optional Ant tasks needed by the "test" target -->
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-junit</artifactId>
            <version>1.10.15</version>
          </dependency>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-junit4</artifactId>
            <version>1.10.15</version>
          </dependency>
        </dependencies>
        <!-- -D properties given on the Maven command line (e.g. jdk.git.url, jdk.git.commit) are passed to Ant -->
        <executions>
          <execution>
            <id>clean</id>
            <phase>clean</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="clean" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>checkout-jdk</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="init" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jackpot</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="generate-files" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="compile" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>test</id>
            <phase>test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
                <skip>${skipTests}</skip>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="test" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="jar" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>sources-zip</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <ant dir="${nbjavac.ant.dir}" target="zip-nb-javac-sources" inheritAll="false">
                  <property name="jdk.git.url" value="${jdk.git.url}"/>
                  <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                  <propertyset>
                    <propertyref builtin="commandline"/>
                  </propertyset>
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- both need -Dmaven.groupId=your.grp.id -->
    <profile>
      <id>ossrh-snapshots</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>ossrh-snapshots</id>
                <phase>deploy</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <ant dir="${nbjavac.ant.dir}" target="publish-to-ossrh-snapshots" inheritAll="false">
                      <property name="jdk.git.url" value="${jdk.git.url}"/>
                      <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                      <propertyset>
                        <propertyref builtin="commandline"/>
                      </propertyset>
                    </ant>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>maven-central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>maven-central</id>
                <phase>deploy</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <ant dir="${nbjavac.ant.dir}" target="publish-to-maven-central" inheritAll="false">
                      <property name="jdk.git.url" value="${jdk.git.url}"/>
                      <property name="jdk.git.commit" value="${jdk.git.commit}"/>
                      <propertyset>
                        <propertyref builtin="commandline"/>
                      </propertyset>
                    </ant>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
