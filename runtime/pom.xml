<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dukescript.nbjavac</groupId>
        <artifactId>nb-javac-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>nb-javac-runtime-parent</artifactId>
    <packaging>pom</packaging>
    <name>nb-javac runtime build</name>
    <modules>
        <module>run-on-jdk8</module>
        <module>run-on-jdk21</module>
    </modules>

    <properties>
        <nbjavac.root>${project.basedir}/..</nbjavac.root>
        <nbjavac.ant.dir>${nbjavac.root}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
        <nbjavac.output.dir>${project.build.directory}</nbjavac.output.dir>
        <src.dir>${project.build.directory}/generated/java</src.dir>
        <propertiesparser.classes.dir>${project.build.directory}/propertiesparser</propertiesparser.classes.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dukescript.nbjavac</groupId>
            <artifactId>nb-javac</artifactId>
            <version>jdk-21u</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${nbjavac.root}/src/main/java</sourceDirectory>
        <testSourceDirectory>${nbjavac.root}/src/test/java</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>${nbjavac.root}/src/test/resources</directory>
            </testResource>
        </testResources>
        <resources>
            <resource>
                <directory>${nbjavac.root}</directory>
                <includes>
                    <include>README.md</include>
                    <include>SECURITY.md</include>
                </includes>
            </resource>
            <resource>
                <directory>${nbjavac.root}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${src.dir}/java.compiler/share/classes</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${src.dir}/jdk.compiler/share/classes</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                    <exclude>com/sun/tools/javac/launcher/**</exclude>
                    <exclude>com/sun/tools/javac/sym/**</exclude>
                    <exclude>com/sun/tools/sjavac/**</exclude>
                    <exclude>sun/**</exclude>
                </excludes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.dukescript.nbjavac</groupId>
                            <artifactId>nb-javac-ctsym</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>unpack-reflect</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>unpack</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                <includes>nbjavac/sun/annotation/**,com/sun/tools/classfile/**,com/sun/tools/javap/**</includes>
                                <artifactItems>
                                    <artifactItem>
                                        <groupId>com.dukescript.nbjavac</groupId>
                                        <artifactId>nb-javac</artifactId>
                                        <version>jdk-21u</version>
                                    </artifactItem>
                                </artifactItems>
                            </configuration>
                        </execution>
                        <execution>
                            <id>unpack-ct-sym</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>unpack</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                <includes>META-INF/ct*/**</includes>
                                <artifactItems>
                                    <artifactItem>
                                        <groupId>com.dukescript.nbjavac</groupId>
                                        <artifactId>nb-javac-ctsym</artifactId>
                                        <version>${project.version}</version>
                                    </artifactItem>
                                </artifactItems>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.ant</groupId>
                            <artifactId>ant</artifactId>
                            <version>1.10.15</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.ant</groupId>
                            <artifactId>ant-launcher</artifactId>
                            <version>1.10.15</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <target>
                            <ant dir="${nbjavac.ant.dir}" target="generate-files" inheritAll="true"/>
                        </target>
                    </configuration>
                    <executions>
                        <execution>
                            <id>jackpot</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <id>add-source</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>add-source</goal>
                            </goals>
                            <configuration>
                                <sources>
                                    <source>${src.dir}/java.compiler/share/classes</source>
                                    <source>${src.dir}/jdk.compiler/share/classes</source>
                                    <source>${src.dir}/java.base/share/classes</source>
                                </sources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>copy-sourceversion-java11</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>copy-resources</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/sourceversion-java11/javax/lang/model</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>${nbjavac.root}/jdk/src/java.compiler/share/classes/javax/lang/model</directory>
                                        <includes>
                                            <include>SourceVersion.java</include>
                                        </includes>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                        <execution>
                            <id>copy-source-archive</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>copy-resources</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/source-archive</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>${nbjavac.root}</directory>
                                        <includes>
                                            <include>src/main/java/**</include>
                                            <include>src/test/java/**</include>
                                            <include>src/test/resources/**</include>
                                            <include>src/main/resources/**</include>
                                            <include>make/langtools/netbeans/nb-javac/**</include>
                                            <include>make/langtools/tools/**</include>
                                            <include>make/langtools/build.xml</include>
                                            <include>make/langtools/build.properties</include>
                                            <include>README.md</include>
                                            <include>SECURITY.md</include>
                                            <include>LICENSE.txt</include>
                                            <include>CONTRIBUTING.md</include>
                                        </includes>
                                        <excludes>
                                            <exclude>**/build/**</exclude>
                                            <exclude>**/dist/**</exclude>
                                        </excludes>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                        <execution>
                            <id>copy-generated-source-archive</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>copy-resources</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/source-archive/src/generated/java</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>${src.dir}</directory>
                                        <includes>
                                            <include>java.base/**</include>
                                            <include>java.compiler/**</include>
                                            <include>jdk.compiler/**</include>
                                        </includes>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.frgaal</groupId>
                            <artifactId>compiler-maven-plugin</artifactId>
                            <version>25.0.0</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <compilerId>frgaal</compilerId>
                        <source>24</source>
                        <target>${runtime.target}</target>
                        <encoding>UTF-8</encoding>
                        <debug>true</debug>
                        <createMissingPackageInfoClass>false</createMissingPackageInfoClass>
                        <compilerArgs>
                            <arg>--limit-modules</arg>
                            <arg>java.base</arg>
                        </compilerArgs>
                        <excludes>
                            <exclude>**/module-info.java</exclude>
                            <exclude>com/sun/tools/javac/launcher/**</exclude>
                            <exclude>com/sun/tools/javac/main/JavacToolProvider.java</exclude>
                            <exclude>com/sun/tools/sjavac/**</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>compile-sourceversion-java11</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                            <configuration>
                                <compileSourceRoots>
                                    <compileSourceRoot>${project.build.directory}/sourceversion-java11</compileSourceRoot>
                                </compileSourceRoots>
                                <includes>
                                    <include>javax/lang/model/SourceVersion.java</include>
                                </includes>
                                <target>11</target>
                                <useIncrementalCompilation>false</useIncrementalCompilation>
                                <outputDirectory>${project.build.outputDirectory}/META-INF/versions/11</outputDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <reuseForks>false</reuseForks>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                    <!-- The API module prepares the shared checkout and Jackpot tool first. -->
                    <dependencies>
                        <dependency>
                            <groupId>com.dukescript.nbjavac</groupId>
                            <artifactId>nb-javac-api</artifactId>
                            <version>${project.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <archive>
                            <addMavenDescriptor>false</addMavenDescriptor>
                        </archive>
                    </configuration>
                    <executions>
                        <execution>
                            <id>default-jar</id>
                            <configuration>
                                <includes>
                                    <include>META-INF/services/**</include>
                                    <include>META-INF/ct*/**</include>
                                    <include>com/sun/tools/**</include>
                                    <include>jdk/internal/shellsupport/**</include>
                                    <include>jdk/internal/PreviewFeature*</include>
                                    <include>nbjavac/**</include>
                                    <include>README.md</include>
                                    <include>SECURITY.md</include>
                                </includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>sources-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <classifier>sources</classifier>
                                <classesDirectory>${project.build.directory}/source-archive</classesDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>jdk8-tests</id>
            <activation>
                <jdk>1.8</jdk>
            </activation>
            <properties>
                <argLine>-Xbootclasspath/p:${project.build.outputDirectory}</argLine>
            </properties>
        </profile>
        <profile>
            <id>jdk9-tests</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <argLine>-Ddebug=false --limit-modules java.base,java.xml,jdk.zipfs,java.management,java.logging</argLine>
            </properties>
        </profile>
    </profiles>
</project>
