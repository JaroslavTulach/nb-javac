<?xml version="1.0" encoding="UTF-8"?>
<!--
    Helper script called from code/pom.xml. It prepares the sources and
    can install the built jars into a NetBeans distribution.
    The classes are compiled, tested and packaged by Maven.
    Do not call this script directly, use `mvn`.
-->
<project name="nb-javac" default="generate-files" basedir=".">
    <description>Prepares sources of nb-javac.</description>

    <!-- jdk.git.url and jdk.git.commit are defined by pom.xml -->
    <property name="root" location="../../../.."/>
    <property name="jdk.repo" location="${root}/jdk"/>
    <property name="src.dir" location="${root}/src/generated/java"/>
    <property name="tools.dir" location="${root}/lib"/>

    <target name="-check-properties">
        <fail unless="jdk.git.url" message="Property jdk.git.url is not defined. Build with Maven (mvn) or specify -Djdk.git.url=..."/>
        <fail unless="jdk.git.commit" message="Property jdk.git.commit is not defined. Build with Maven (mvn) or specify -Djdk.git.commit=..."/>
        <fail message="Build tools are missing in ${tools.dir}. They are downloaded by Maven, run 'mvn initialize'.">
            <condition>
                <not>
                    <available file="${tools.dir}/jackpot.jar"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="-check-jdk.is.available">
        <available property="jdk.is.available" file="${jdk.repo}"/>
    </target>

    <target name="-prepare-jackpot.marker">
        <fail unless="jackpot.profile" message="Select a Jackpot profile, for example -Pjdk8+ or -Pjdk21+."/>
        <fail unless="jackpot.hint.files" message="The selected Jackpot hint files are not configured."/>
        <mkdir dir="${nbjavac.output.dir}"/>
        <property name="jackpot.combined.hint.file"
                  location="${nbjavac.output.dir}/nbjavac-${jackpot.profile}.hint"/>
        <concat destfile="${jackpot.combined.hint.file}" fixlastline="yes">
            <filelist dir="${root}/src/main/resources/META-INF/upgrade"
                      files="${jackpot.hint.files}"/>
        </concat>
        <checksum file="${jackpot.combined.hint.file}" algorithm="SHA-256"
                  property="jackpot.hint.checksum"/>
        <property name="jackpot.marker.expected"
                  value="${jackpot.profile}|${jdk.git.commit}|${jackpot.hint.checksum}"/>
        <available property="jackpot.marker.exists" file="${src.dir}/jackpot-done"/>
    </target>

    <target name="-check-jackpot.marker" depends="-prepare-jackpot.marker" if="jackpot.marker.exists">
        <loadfile property="jackpot.marker.actual" srcfile="${src.dir}/jackpot-done">
            <filterchain>
                <striplinebreaks/>
            </filterchain>
        </loadfile>
        <condition property="jackpot.has.been.applied">
            <equals arg1="${jackpot.marker.actual}" arg2="${jackpot.marker.expected}"/>
        </condition>
    </target>

    <target name="-checkout-jdk" depends="-check-jdk.is.available" unless="jdk.is.available">
        <exec failonerror="true" executable="git" dir="${jdk.repo}/..">
            <arg value="clone"/>
            <arg value="${jdk.git.url}"/>
            <arg value="jdk"/>
        </exec>
        <exec failonerror="true" executable="git" dir="${jdk.repo}">
            <arg value="checkout"/>
            <arg value="${jdk.git.commit}"/>
        </exec>
    </target>

    <target name="init" depends="-check-properties,-checkout-jdk" description="Checks the OpenJDK sources out."/>

    <target name="install-netbeans" description="Installs the built jars into a NetBeans distribution.">
        <fail unless="netbeans.dest.dir" message="Specify -Dnetbeans.dest.dir=/path/to/netbeans/nbbuild/netbeans"/>
        <property name="netbeans.ext.dir" location="${netbeans.dest.dir}/java/modules/ext"/>
        <available file="${netbeans.dest.dir}/java/modules/org-netbeans-libs-nbjavacapi.jar"
                   type="file" property="netbeans.module.exists"/>
        <fail unless="netbeans.module.exists"
              message="No org-netbeans-libs-nbjavacapi.jar found under ${netbeans.dest.dir}/java/modules"/>
        <available file="${netbeans.ext.dir}" type="dir" property="netbeans.ext.exists"/>
        <fail unless="netbeans.ext.exists"
              message="No Java module extension directory found at ${netbeans.ext.dir}"/>

        <resourcecount property="netbeans.impl.count">
            <fileset dir="${netbeans.ext.dir}">
                <include name="nb-javac-jdk-*.jar"/>
                <exclude name="*-api.jar"/>
            </fileset>
        </resourcecount>
        <resourcecount property="netbeans.api.count">
            <fileset dir="${netbeans.ext.dir}">
                <include name="nb-javac-jdk-*-api.jar"/>
            </fileset>
        </resourcecount>
        <condition property="netbeans.impl.unique">
            <equals arg1="${netbeans.impl.count}" arg2="1"/>
        </condition>
        <condition property="netbeans.api.unique">
            <equals arg1="${netbeans.api.count}" arg2="1"/>
        </condition>
        <fail unless="netbeans.impl.unique"
              message="Expected exactly one nb-javac implementation JAR in ${netbeans.ext.dir}; found ${netbeans.impl.count}"/>
        <fail unless="netbeans.api.unique"
              message="Expected exactly one nb-javac API JAR in ${netbeans.ext.dir}; found ${netbeans.api.count}"/>

        <pathconvert property="netbeans.impl.jar">
            <path>
                <fileset dir="${netbeans.ext.dir}">
                    <include name="nb-javac-jdk-*.jar"/>
                    <exclude name="*-api.jar"/>
                </fileset>
            </path>
        </pathconvert>
        <pathconvert property="netbeans.api.jar">
            <path>
                <fileset dir="${netbeans.ext.dir}">
                    <include name="nb-javac-jdk-*-api.jar"/>
                </fileset>
            </path>
        </pathconvert>
        <copy file="${nbjavac.output.dir}/${nbjavac.implementation.finalName}.jar"
              tofile="${netbeans.impl.jar}" overwrite="true"/>
        <copy file="${nbjavac.output.dir}/nb-javac-${revision}-api.jar"
              tofile="${netbeans.api.jar}" overwrite="true"/>
        <touch file="${netbeans.dest.dir}/java/.lastModified"/>
    </target>

    <target name="-check-generated-files">
        <uptodate property="generated.files.up.to.date"
                  srcfile="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/code/Flags.java"
                  targetfile="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/code/FlagsEnum.java" />
    </target>

    <target name="generate-files" depends="jackpot,-check-generated-files" unless="generated.files.up.to.date"
            description="Generates the sources which are not part of the OpenJDK repository.">
        <mkdir dir="${root}/lib/propertiesparser"/>
        <javac destdir="${root}/lib/propertiesparser" source="25" target="25" release="25" debug="true" srcdir="${jdk.repo}/make/langtools/tools/">
            <include name="propertiesparser/**/*.java"/>
            <include name="flagsgenerator/**/*.java"/>
        </javac>
        <path id="propertiesparser">
            <pathelement location="${root}/lib/propertiesparser"/>
            <pathelement location="${jdk.repo}/make/langtools/tools/"/>
        </path>
        <java failonerror="true" classpathref="propertiesparser" classname="propertiesparser.PropertiesParser">
            <arg value="-compile"/>
            <arg value="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/resources/compiler.properties"/>
            <arg value="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/resources/"/>
        </java>
        <java failonerror="true" classpathref="propertiesparser" classname="propertiesparser.PropertiesParser">
            <arg value="-compile"/>
            <arg value="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/resources/launcher.properties"/>
            <arg value="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/resources/"/>
        </java>
        <java failonerror="true" classpathref="propertiesparser" classname="flagsgenerator.FlagsGenerator" fork="true">
            <arg value="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/code/Flags.java"/>
            <arg value="${src.dir}/jdk.compiler/share/classes/com/sun/tools/javac/code/FlagsEnum.java"/>
        </java>
    </target>

    <target name="jackpot" depends="init,-check-jackpot.marker" unless="jackpot.has.been.applied"
            description="Copies the OpenJDK sources and applies the refactorings to them.">
        <delete dir="${src.dir}"/>
        <delete dir="${root}/src/java.base"/>
        <delete dir="${root}/src/java.compiler"/>
        <delete dir="${root}/src/jdk.compiler"/>
        <delete file="${root}/src/jackpot-done"/>
        <mkdir dir="${src.dir}"/>
        <copy todir="${src.dir}">
            <fileset dir="${jdk.repo}/src/">
                <selector>
                    <and>
                        <or>
                            <filename name="java.compiler/**"/>
                            <filename name="jdk.compiler/**"/>
                        </or>
                        <!-- module descriptors are not compiled and would put the Maven compiler into module mode -->
                        <not>
                            <filename name="**/module-info.java"/>
                        </not>
                        <containsregexp expression="particular *file *as *subject *to *the.*Classpath.*exception"/>
                    </and>
                </selector>
            </fileset>
        </copy>
        <copy todir="${src.dir}">
            <fileset dir="${jdk.repo}/src/">
                <selector>
                    <and>
                        <or>
                            <filename name="java.base/share/classes/java/lang/runtime/ExactConversionsSupport.java"/>
                        </or>
                        <containsregexp expression="particular *file *as *subject *to *the.*Classpath.*exception"/>
                    </and>
                </selector>
            </fileset>
            <filterchain>
                 <replacestring from="package java.lang.runtime;" to="package nbjavac.jdk21;"/>
            </filterchain>
        </copy>

        <java fork="true" failonerror="true" classpath="${tools.dir}/jackpot.jar" classname="org.netbeans.modules.jackpot30.cmdline.Main">
            <arg value="-hint-file"/>
            <arg value="${jackpot.combined.hint.file}"/>
            <arg value="-sourcepath"/>
            <arg value="${root}/src/main/java/:${src.dir}/jdk.compiler/share/classes/:${src.dir}/java.compiler/share/classes:${src.dir}/java.base/share/classes"/>
            <arg value="-source"/>
            <arg value="8"/>
            <arg value="--apply"/>
            <arg value="${src.dir}/java.base/share/classes"/>
            <arg value="${src.dir}/java.compiler/share/classes"/>
            <arg value="${src.dir}/jdk.compiler/share/classes"/>
        </java>
        <echo file="${src.dir}/jackpot-done">${jackpot.marker.expected}</echo>
    </target>
</project>
