<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.dukescript.nbjavac</groupId>
    <artifactId>nb-javac-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>nb-javac</artifactId>
  <packaging>jar</packaging>
  <name>nb-javac</name>
  <description>
    `nb-javac` is a "backport" of OpenJDK `javac`, i.e., the Java compiler.
    It allows to run the latest OpenJDK compiler on older JDKs - as old
    as JDK8 while being 1:1 identical with the official `javac`.
    Use `nb-javac` to execute the latest Java language compiler on old JDKs!
  </description>
  <url>https://github.com/jaroslavtulach/nb-javac</url>
  <licenses><license>
    <name>GPLv2-CPE</name><url>https://openjdk.java.net/legal/gplv2+ce.html</url><distribution>repo</distribution>
  </license></licenses>
  <scm>
    <connection>scm:git:https://github.com/jaroslavtulach/nb-javac.git</connection>
    <developerConnection>scm:git:git@github.com:jaroslavtulach/nb-javac.git</developerConnection>
    <url>https://github.com/jaroslavtulach/nb-javac</url>
  </scm>
  <developers><developer>
    <email>jaroslav.tulach@apidesign.org</email><name>Jaroslav Tulach</name>
    <url>https://github.com/jaroslavtulach</url><roles><role>Developer</role></roles>
  </developer></developers>

  <properties>
    <nbjavac.root>${project.basedir}/..</nbjavac.root>
    <nbjavac.ant.dir>${nbjavac.root}/make/langtools/netbeans/nb-javac</nbjavac.ant.dir>
    <nbjavac.output.dir>${project.build.directory}</nbjavac.output.dir>
    <nbjavac.implementation.finalName>${project.build.finalName}</nbjavac.implementation.finalName>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-api</artifactId>
      <version>${project.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-run-on-jdk8</artifactId>
      <version>${project.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-run-on-jdk21</artifactId>
      <version>${project.version}</version><scope>provided</scope>
    </dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.12</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testSourceDirectory>${nbjavac.root}/src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration>
          <source>8</source><target>8</target>
          <testIncludes><testInclude>nbjavac/*IT.java</testInclude></testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-main-and-api</id><phase>package</phase><goals><goal>unpack</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <overWriteReleases>true</overWriteReleases><overWriteSnapshots>true</overWriteSnapshots>
              <excludes>META-INF/MANIFEST.MF,META-INF/versions/*/META-INF/**</excludes>
              <artifactItems>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-run-on-jdk8</artifactId><version>${project.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-api</artifactId><version>${project.version}</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>copy-artifacts</id><phase>package</phase><goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <overWriteReleases>true</overWriteReleases><overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-api</artifactId><version>${project.version}</version>
                  <destFileName>${project.build.finalName}-api.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-run-on-jdk21</artifactId><version>${project.version}</version>
                  <destFileName>${project.build.finalName}-jdk21.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-run-on-jdk8</artifactId><version>${project.version}</version><classifier>sources</classifier>
                  <destFileName>${project.build.finalName}-sources.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>com.dukescript.nbjavac</groupId><artifactId>nb-javac-run-on-jdk21</artifactId><version>${project.version}</version><classifier>sources</classifier>
                  <destFileName>${project.build.finalName}-jdk21-sources.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.0</version>
        <executions><execution>
          <id>attach-artifacts</id><phase>package</phase><goals><goal>attach-artifact</goal></goals>
          <configuration><artifacts>
            <artifact><file>${project.build.directory}/${project.build.finalName}-api.jar</file><type>jar</type><classifier>api</classifier></artifact>
            <artifact><file>${project.build.directory}/${project.build.finalName}-jdk21.jar</file><type>jar</type><classifier>jdk21</classifier></artifact>
            <artifact><file>${project.build.directory}/${project.build.finalName}-sources.jar</file><type>jar</type><classifier>sources</classifier></artifact>
            <artifact><file>${project.build.directory}/${project.build.finalName}-jdk21-sources.jar</file><type>jar</type><classifier>jdk21-sources</classifier></artifact>
          </artifacts></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><archive><addMavenDescriptor>false</addMavenDescriptor></archive></configuration>
        <executions>
          <execution><id>default-jar</id><phase>none</phase></execution>
          <execution>
            <id>assemble-main</id><phase>package</phase><goals><goal>jar</goal></goals>
            <configuration><includes>
              <include>META-INF/services/**</include><include>META-INF/ct*/**</include>
              <include>com/sun/tools/**</include><include>jdk/internal/shellsupport/**</include>
              <include>jdk/internal/PreviewFeature*</include><include>nbjavac/**</include>
              <include>README.md</include><include>SECURITY.md</include>
            </includes></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>flatten-maven-plugin</artifactId><version>1.7.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile><flattenMode>ossrh</flattenMode>
          <pomElements><dependencies>remove</dependencies></pomElements>
        </configuration>
        <executions>
          <execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution>
          <execution><id>flatten-clean</id><phase>clean</phase><goals><goal>clean</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId><version>3.5.3</version>
        <configuration><systemPropertyVariables>
          <nbjavac.api.jar>${project.build.directory}/${project.build.finalName}-api.jar</nbjavac.api.jar>
          <nbjavac.api.module.jar>${nbjavac.root}/api/target/nb-javac-api-${project.version}.jar</nbjavac.api.module.jar>
          <nbjavac.classes.dir>${nbjavac.root}/run-on-jdk8/target/classes</nbjavac.classes.dir>
          <nbjavac.implementation.jar>${project.build.directory}/${project.build.finalName}.jar</nbjavac.implementation.jar>
          <nbjavac.implementation21.jar>${project.build.directory}/${project.build.finalName}-jdk21.jar</nbjavac.implementation21.jar>
          <nbjavac.runtime8.jar>${nbjavac.root}/run-on-jdk8/target/nb-javac-run-on-jdk8-${project.version}.jar</nbjavac.runtime8.jar>
          <nbjavac.runtime21.jar>${nbjavac.root}/run-on-jdk21/target/nb-javac-run-on-jdk21-${project.version}.jar</nbjavac.runtime21.jar>
          <nbjavac.ctsym.jar>${nbjavac.root}/ctsym/target/nb-javac-ctsym-${project.version}.jar</nbjavac.ctsym.jar>
        </systemPropertyVariables></configuration>
        <executions><execution><phase>package</phase><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      </plugin>
      <plugin><groupId>net.nicoulaj.maven.plugins</groupId><artifactId>checksum-maven-plugin</artifactId><version>1.11</version></plugin>
    </plugins>
  </build>
  <profiles>
    <profile><id>jdk8+</id></profile>
    <profile>
      <id>jdk21+</id>
      <properties><nbjavac.implementation.finalName>${project.build.finalName}-jdk21</nbjavac.implementation.finalName></properties>
    </profile>
    <profile>
      <id>install-netbeans</id><activation><property><name>netbeans.dest.dir</name></property></activation>
      <build><plugins><plugin>
        <artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version>
        <dependencies>
          <dependency><groupId>org.apache.ant</groupId><artifactId>ant</artifactId><version>1.10.15</version></dependency>
          <dependency><groupId>org.apache.ant</groupId><artifactId>ant-launcher</artifactId><version>1.10.15</version></dependency>
        </dependencies>
        <executions><execution>
          <id>install-netbeans</id><phase>install</phase><goals><goal>run</goal></goals>
          <configuration><target><ant dir="${nbjavac.ant.dir}" target="install-netbeans" inheritAll="true"/></target></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>release</id>
      <build><plugins>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <executions><execution>
            <id>javadoc-jar</id><phase>package</phase><goals><goal>jar</goal></goals>
            <configuration>
              <classifier>javadoc</classifier><classesDirectory>${nbjavac.root}</classesDirectory>
              <includes><include>README.md</include><include>SECURITY.md</include><include>LICENSE.txt</include><include>CONTRIBUTING.md</include></includes>
            </configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
          <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
        </plugin>
        <plugin>
          <groupId>net.nicoulaj.maven.plugins</groupId><artifactId>checksum-maven-plugin</artifactId>
          <executions><execution>
            <id>checksum-installed-artifacts</id><phase>install</phase><goals><goal>files</goal></goals>
            <configuration>
              <fileSets><fileSet>
                <directory>${settings.localRepository}/com/dukescript/nbjavac/${project.artifactId}/${project.version}</directory>
                <includes><include>*.jar</include><include>*.pom</include></includes>
              </fileSet></fileSets>
              <individualFilesOutputDirectory>${project.build.directory}/release-checksums</individualFilesOutputDirectory>
              <csvSummary>false</csvSummary>
            </configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <executions><execution>
            <id>install-checksums</id><phase>install</phase><goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${settings.localRepository}/com/dukescript/nbjavac/${project.artifactId}/${project.version}</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource>
                <directory>${project.build.directory}/release-checksums</directory>
                <includes>
                  <include>${project.artifactId}-${project.version}*.jar.md5</include>
                  <include>${project.artifactId}-${project.version}*.jar.sha1</include>
                  <include>${project.artifactId}-${project.version}.pom.md5</include>
                  <include>${project.artifactId}-${project.version}.pom.sha1</include>
                </includes>
              </resource></resources>
            </configuration>
          </execution></executions>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
